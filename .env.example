# Frontend
VITE_API_BASE_URL=http://localhost:8000/api

# Backend
REVORA_HOST=0.0.0.0
REVORA_PORT=8000
REVORA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hugging Face local pipelines. Public models work without a token, but setting
# your own account token makes project usage explicit for the hackathon.
HF_ASR_MODEL=openai/whisper-tiny.en
HF_AUDIO_MODEL=superb/wav2vec2-base-superb-er
# Keep disabled for the fast, reliable acoustic-feature MVP. Set to 1 only
# after the optional emotion-model weights have been downloaded successfully.
HF_ENABLE_AUDIO_MODEL=0
HF_DEVICE=-1
HF_INFERENCE_TIMEOUT_SECONDS=120
HF_MODEL_DOWNLOAD_TIMEOUT_SECONDS=120
# HF_TOKEN=hf_your_read_token

